#version 450 core

layout(local_size_x = 64) in; // doesnt matter unless different data is read from two invocations.

#define MAX_LIGHTS_PER_CLUSTER 128

struct GridAABB {
	vec4 from;
	vec4 to;
};
struct PointLight { 
	vec4 positionRange;
	vec4 colorIntensity;
};
struct ClusterLights {
	uint lightsIndices[MAX_LIGHTS_PER_CLUSTER];
};

uniform uint nPointLight;
uniform uint clusterCount;
uniform mat4 uView;

layout(std430, binding = 0) readonly buffer LightSSBO { PointLight lights[]; };
layout(std430, binding = 1) readonly buffer ClusterSSBO { GridAABB clusters[]; };
layout(std430, binding = 2) buffer CountSSBO { uint counts[]; };
layout(std430, binding = 3) buffer IndexSSBO { ClusterLights indices[]; };

void main() {
	// cluster we are in
	uint idx = gl_GlobalInvocationID.x;
	if (idx >= clusterCount) return;
	GridAABB cluster = clusters[idx];

	// iterate lights
	for (int i = 0; i < nPointLight; i++) {
		PointLight light = lights[i];
		
		// aabb check
		vec3 lightPosition = (uView * vec4(light.positionRange.xyz, 1.0)).xyz;
		if (lightPosition.x - light.positionRange.w < cluster.to.x &&
			lightPosition.x + light.positionRange.w > cluster.from.x &&
			lightPosition.y - light.positionRange.w < cluster.to.y &&
			lightPosition.y + light.positionRange.w > cluster.from.y &&
			-lightPosition.z - light.positionRange.w < cluster.to.z &&
			-lightPosition.z + light.positionRange.w > cluster.from.z) {
			// Light is in the cluster
			uint count = atomicAdd(counts[idx], 1u);
			if (count < MAX_LIGHTS_PER_CLUSTER) indices[idx].lightsIndices[count] = i;
		}
	}
}
